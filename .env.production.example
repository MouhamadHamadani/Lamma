# Lamma: production settings for ONE Ubuntu server (nginx + PHP-FPM + MySQL + Redis + Supervisor). See docs/deployment.md.
# Copy to .env on the server, fill every empty value, then:  php artisan key:generate && php artisan lamma:doctor
# "lamma.example" is a placeholder: replace it with the real domain everywhere it appears (APP_URL, REVERB_HOST, MAIL_FROM_ADDRESS).
# Never commit the real .env.

APP_NAME=Lamma
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lamma.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One log file per day, warnings and worse only (see docs/deployment.md for where they are and how long they are kept).
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8 on the same server. Use a dedicated user with rights on this database only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lamma
DB_USERNAME=lamma
DB_PASSWORD=

# Redis for the cache, the queue and sessions.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

# Real mail (password reset). Fill in your provider's SMTP details; with MAIL_MAILER=log nothing is ever delivered.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@lamma.example"
MAIL_FROM_NAME="${APP_NAME}"

# Real time. Reverb listens only on this machine (127.0.0.1:8080); nginx exposes it as wss://<domain>/app on port 443.
# Generate the three values with:  php -r "echo bin2hex(random_bytes(16)),PHP_EOL;"   (run it three times)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# What browsers connect to (the public side of nginx):
REVERB_HOST=lamma.example
REVERB_PORT=443
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The Filament admin at /admin. Used only by: php artisan db:seed --class=AdminSeeder --force
# It refuses to run unless the email is valid and the password has 12+ characters with upper and lower case, a number and a symbol.
# Remove ADMIN_PASSWORD from this file once the admin exists.
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
